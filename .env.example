# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Random secret that encrypts the login cookie. Generate with: npx auth secret
AUTH_SECRET=

# From Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The one Google account allowed to sign in
ALLOWED_EMAIL=
